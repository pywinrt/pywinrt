# Every top-level directory starting with "_" is build output: _build holds the
# CMake build trees, _install the install prefixes, _tools the downloaded
# packages, _typing the packages merged for the type checkers and _site the
# documentation.
/_*/

# A projection table is carried as text and compiled when the projection is
# built, so the binary is build output wherever it turns up.
_table.pywinrt

# The .dlls a package redistributes are taken out of a NuGet package as it is
# built, so they are build output rather than something this repository keeps.
/redist/*/nuget/

# Python
__pycache__/
*.pyc
*.egg-info/
.venv/
/wheelhouse/
build/

# .NET, which builds PyWinRT
bin/
obj/
*.binlog

# Editors
.vs/
.vscode/
*.user
