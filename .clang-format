---
BasedOnStyle: Microsoft
UseTab: Never
IndentWidth: 4
# .gitattributes checks every file out with LF, so say so rather than letting
# clang-format infer the ending from whatever the file happens to hold: an
# editor or a script that wrote CRLF once would otherwise have every later
# reformat keep it.
LineEnding: LF
---
Language: Cpp
Standard: c++20
BreakBeforeBraces: Allman
AllowShortIfStatementsOnASingleLine: false
IndentCaseLabels: false
ColumnLimit: 88
NamespaceIndentation: All
PointerAlignment: Left
AllowShortLambdasOnASingleLine: false
AlignAfterOpenBracket: AlwaysBreak
BinPackArguments: false
BinPackParameters: false
SpaceAfterTemplateKeyword: false
BreakBeforeBinaryOperators: true
BreakStringLiterals: false
AlwaysBreakTemplateDeclarations: Yes
SortIncludes: false
# These expand to a declaration that already ends in a semicolon, so without
# this the next member is folded onto the same line as the macro.
StatementMacros: [PyObject_HEAD, PyObject_VAR_HEAD]
